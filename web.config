<?xml version="1.0" encoding="UTF-8"?>
<!-- ============================================================
     jsonSQLDB - Protección de la raíz del proyecto en IIS.
     Equivalente al .htaccess: solo se sirve la carpeta api/.
     ============================================================ -->
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <!-- Carpetas internas no accesibles -->
        <hiddenSegments>
          <add segment="engine" />
          <add segment="data" />
          <add segment="logs" />
          <add segment="docs" />
          <add segment="tests" />
        </hiddenSegments>
        <!-- Extensiones no servibles -->
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".json" allowed="false" />
          <add fileExtension=".md" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".lock" allowed="false" />
          <add fileExtension=".cache" allowed="false" />
          <add fileExtension=".tmp" allowed="false" />
        </fileExtensions>
        <denyUrlSequences>
          <add sequence=".." />
        </denyUrlSequences>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
