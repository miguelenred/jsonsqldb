# jsonSQLDB - acceso denegado a esta carpeta desde el navegador
<IfModule mod_authz_core.c>
    # Apache 2.4
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    # Apache 2.2
    Order allow,deny
    Deny from all
</IfModule>
Options -Indexes
# Y aunque se llegara, nada de aquí se ejecuta como PHP (2.10)
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
