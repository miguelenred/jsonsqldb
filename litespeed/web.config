<?xml version="1.0" encoding="UTF-8"?>
<!-- jsonSQLDB - acceso denegado a esta carpeta desde IIS -->
<configuration>
  <system.webServer>
    <security>
      <authorization>
        <deny users="*" />
      </authorization>
      <requestFiltering>
        <hiddenSegments><add segment="." /></hiddenSegments>
      </requestFiltering>
    </security>
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
